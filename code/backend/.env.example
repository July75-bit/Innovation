# 复制为 backend/.env 后填写真实值；.env 已被 .gitignore 忽略，绝不能提交。
# PowerShell: Copy-Item .env.example .env

# ---------- 应用 ----------
# 数据库地址。本地用相对路径（按 code/backend 解析，别写成仓库根）；
# 线上（Render）**必须**填 Postgres：把 DATABASE_URL 设为 Render Postgres 的
# Internal Database URL（postgresql://...）。免费实例的文件系统是临时的，
# 用 SQLite 会随重新部署/休眠丢数据。裸 postgres:// 或 postgresql:// 都会被
# app/core/config.py 自动补成 postgresql+psycopg2://（SQLAlchemy 2.1 的默认驱动是
# psycopg 3，而本项目装的是 psycopg2-binary，不补会 ModuleNotFoundError: psycopg）。
DATABASE_URL=sqlite:///./playerstock.db

# 允许跨域的前端来源，多个用英文逗号分隔。
# 线上部署时换成前端公网地址，例如 https://playerstock-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 交易规则（B 读取，不要在代码里写死） ----------
INITIAL_BALANCE=5000
MAX_POSITION_PER_PLAYER=50

# ---------- 定价参数（C 读取） ----------
PRICING_ALPHA=0.15
PRICING_BETA=0.0
PRICING_FLOOR=1.0

# ---------- 大模型（D 读取；密钥只留在后端，绝不下发前端） ----------
# 没有可用密钥时留空，AI 接口应自动降级为规则版建议，交易功能不受影响。
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
