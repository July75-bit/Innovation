{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "PlayerStock Design Tokens",
  "version": "2.0.0",
  "modes": {
    "default": "dark",
    "switch": "document.documentElement.dataset.theme = 'light' | 'dark'"
  },
  "meta": {
    "product": "PlayerStock（虚拟选手股交易模拟）",
    "principles": [
      "内容扁平：实色表面 + 1px 边框，禁止玻璃/阴影",
      "控件液态玻璃：只有导航壳与浮层用玻璃，面积 ≤30%",
      "高可读性：正文 16px/1.6，AA 对比度"
    ],
    "wcag": "AA：正文/辅助 ≥4.5:1，≥18.66px 粗体或 ≥24px 大号 ≥3:1",
    "contrastBasis": {
      "dark": "#181b22（表面）",
      "light": "#ffffff（表面）"
    },
    "glassRule": "玻璃令牌只作用于\"会盖住其他内容的壳/浮层\"；内容卡片、表格、表单、长文一律实色",
    "fallback": "@supports not (backdrop-filter) → --glass-solid；prefers-reduced-transparency: reduce → --glass-solid 且去高光",
    "source": "tokens.css（CSS 变量）+ 本文件（JSON），两份同源同值，由 design-tokens.spec.ts 守护",
    "contrastFixes": [
      "品牌红作文字统一走 --accent-text / --up-text（#e5484d 作 16px 文字仅 4.40:1）",
      "浅色模式 success-base 由 #127a45 加深到 #0f6b3d；warning-base 由 #8a5a0f 加深到 #7a4d0a"
    ]
  },
  "groups": [
    "color.neutral",
    "color.canvas",
    "color.primary",
    "color.action",
    "color.semantic",
    "color.surface",
    "color.text",
    "color.border",
    "color.focus",
    "color.overlay",
    "color.business",
    "material.glass",
    "radius.material",
    "typography",
    "spacing",
    "shadow"
  ],
  "tokens": {
    "--color-neutral-0": {
      "group": "color.neutral",
      "light": "#0b0d11",
      "dark": "#f7f8fa",
      "purpose": "最高对比文字（标题强调、大数字）",
      "contrast": {
        "requirement": "AA：正文/辅助 ≥4.5:1，≥18.66px 粗体或 ≥24px 大号 ≥3:1",
        "dark": {
          "on": "#181b22",
          "ratio": 16.22
        },
        "light": {
          "on": "#ffffff",
          "ratio": 19.45
        }
      }
    },
    "--color-neutral-100": {
      "group": "color.neutral",
      "light": "#1a1d23",
      "dark": "#e9eaee",
